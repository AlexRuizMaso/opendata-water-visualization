{
  "name": "etl",
  "version": "1.0.0",
  "description": "ETL scripts for extracting and transforming water data",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "full-pipeline": "node src/index.js",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nock": "^14.0.16",
    "prettier": "^3.1.0",
    "vitest": "^3.2.7"
  }
}
